{
  "name": "ai-video-radar",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-11",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "ai_video_radar_cache" }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "observability": { "enabled": true }
}
