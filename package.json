{
  "name": "ai-video-radar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI 视频情报台 — 聚合中文视频平台的最新 AI 内容",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "crawl": "node scripts/crawl.mjs",
    "crawl:quick": "node scripts/crawl.mjs --quick",
    "deploy": "pnpm crawl && pnpm build && wrangler deploy",
    "cf:dev": "wrangler dev"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@cloudflare/workers-types": "^4.20250705.0",
    "lightningcss": "^1.28.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
